Terminals unused in grammar

    ERROR
    ILLEGAL_TOK


Grammar

    0 $accept: program $end

    1 $@1: ε

    2 program: $@1 declList

    3 declList: decl
    4         | declList decl

    5 decl: varDecl
    6     | funDecl

    7 varDecl: typeSpec ID SEMICLN
    8        | typeSpec ID LSQ_BRKT INTCONST RSQ_BRKT SEMICLN

    9 typeSpec: KWD_INT
   10         | KWD_CHAR
   11         | KWD_VOID

   12 $@2: ε

   13 funDecl: typeSpec ID $@2 LPAREN formalDeclList RPAREN funBody

   14 formalDeclList: ε
   15               | formalDecl
   16               | formalDecl COMMA formalDeclList

   17 formalDecl: typeSpec ID
   18           | typeSpec ID LSQ_BRKT RSQ_BRKT

   19 funBody: LCRLY_BRKT localDeclList stmtList RCRLY_BRKT

   20 localDeclList: ε
   21              | varDecl localDeclList

   22 stmtList: ε
   23         | stmt stmtList

   24 stmt: compoundStmt
   25     | assignStmt
   26     | condStmt
   27     | loopStmt
   28     | returnStmt
   29     | exprStmt

   30 compoundStmt: LCRLY_BRKT localDeclList stmtList RCRLY_BRKT

   31 assignStmt: var OPER_ASGN expr SEMICLN

   32 condStmt: KWD_IF LPAREN expr RPAREN stmt
   33         | KWD_IF LPAREN expr RPAREN stmt KWD_ELSE stmt

   34 loopStmt: KWD_WHILE LPAREN expr RPAREN stmt

   35 returnStmt: KWD_RETURN SEMICLN
   36           | KWD_RETURN expr SEMICLN

   37 exprStmt: expr SEMICLN

   38 var: ID
   39    | ID LSQ_BRKT addExpr RSQ_BRKT

   40 $@3: ε

   41 $@4: ε

   42 funcCallExpr: ID LPAREN $@3 argList $@4 RPAREN

   43 argList: ε
   44        | expr
   45        | argList COMMA expr

   46 expr: addExpr
   47     | addExpr relop addExpr

   48 relop: OPER_LT
   49      | OPER_LTE
   50      | OPER_GT
   51      | OPER_GTE
   52      | OPER_EQ
   53      | OPER_NEQ

   54 addExpr: term
   55        | addExpr addop term

   56 addop: OPER_ADD
   57      | OPER_SUB

   58 term: factor
   59     | term mulop factor

   60 mulop: OPER_MUL
   61      | OPER_DIV

   62 factor: LPAREN expr RPAREN
   63       | var
   64       | funcCallExpr
   65       | INTCONST
   66       | CHARCONST


